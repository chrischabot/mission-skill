{
  "description": "drive: re-inject run state after compaction or resume, hold the session's turn open while its run is unfinished, guard per-agent writes, shell commands (Bash, PowerShell, Monitor), git, and worktrees (including the main thread's writes to verdicts, final audits, live proofs, citation checks, the provenance ledger, and transcripts), record the commits and edits the main thread and makers made, record transcript-backed provenance for evidence files that reviewers write, and void a review whose tracked tree changed under it. Every hook is inert unless .drive/local/active exists in the project, and exits 0 when drive.py is missing.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_ROOT}/scripts/drive.py\"; [ -f \"$p\" ] || exit 0; exec python3 \"$p\" hook-reinject",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_ROOT}/scripts/drive.py\"; [ -f \"$p\" ] || exit 0; exec python3 \"$p\" hook-stop",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor|Edit|Write|NotebookEdit|MultiEdit|EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_ROOT}/scripts/drive.py\"; [ -f \"$p\" ] || exit 0; exec python3 \"$p\" hook-guard",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_ROOT}/scripts/drive.py\"; [ -f \"$p\" ] || exit 0; exec python3 \"$p\" hook-post",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^drive:[a-z-]+$",
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_ROOT}/scripts/drive.py\"; [ -f \"$p\" ] || exit 0; exec python3 \"$p\" hook-snapshot start",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^drive:(verifier|grader|ui-reviewer|auditor|security-reviewer)$",
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PLUGIN_ROOT}/scripts/drive.py\"; [ -f \"$p\" ] || exit 0; exec python3 \"$p\" hook-snapshot stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
